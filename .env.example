# Copy to .env and fill in. Never commit .env.
NODE_ENV=development

# Postgres (local: started with `pnpm db:up`, published on host port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/stackdock

# Secrets — generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
CREDENTIAL_KEY_VERSION=1
# Only while rotating keys (see README → Key rotation):
# CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=

# API server
API_PORT=4000
# Browser origin of the dashboard UI in development (Next.js dev server)
WEB_URL=http://localhost:3000

# Frontend → API base URL (dev only; empty in production because NestJS serves the UI)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Routing mode for projects: northflank-ports | path | host
ROUTING_MODE=path
