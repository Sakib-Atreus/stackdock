{
  "name": "@stackdock/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate",
    "build": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c ../config/oxlintrc.json src --ignore-pattern 'src/generated/**'",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.16.3",
    "prisma": "7.10.1"
  },
  "devDependencies": {
    "@stackdock/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "oxlint": "^1.58.0",
    "typescript": "~6.0.3"
  }
}
